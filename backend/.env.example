# ==============================================================================
# Gadispot Backend Environment Configuration (backend/.env.example)
# Copy this file to backend/.env and adjust values for your environment.
# ==============================================================================

# Application Metadata & Runtime
PROJECT_NAME="Gadispot API"
VERSION="2.3.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"       # Options: development, test, staging, production
DEBUG=false                     # Enable verbose debugging (never enable in production)
LOG_LEVEL="INFO"                # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
HOST="0.0.0.0"
PORT=8000

# PostgreSQL Database (SQLAlchemy AsyncPG Connection)
# Production format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/gadispot_test"
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=10

# Redis In-Memory Cache & Distributed Lock
# Protocol 2 (RESP2) is supported across all Redis versions including Redis 5/6/7
REDIS_URL="redis://127.0.0.1:6379/0"
REDIS_PROTOCOL=2
REDIS_SOCKET_TIMEOUT=5.0
REDIS_SOCKET_CONNECT_TIMEOUT=5.0

# Cryptography & Security
# WARNING: Generate a secure 256-bit random key in production (e.g. openssl rand -hex 32)
SECRET_KEY="development-insecure-secret-key-change-in-production-min32chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed origins, or "*" for development
CORS_ORIGINS="http://localhost:3000,http://localhost:8000,http://localhost:8080,*"

# External Providers & SaaS Integrations (Optional for local development)
FIREBASE_PROJECT_ID=""
FIREBASE_CREDENTIALS_PATH=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
